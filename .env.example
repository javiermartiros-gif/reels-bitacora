# Copia este archivo a .env y rellena con tus datos reales.
# NUNCA subas el .env real a un repo público.

# ID numérico de tu cuenta de Instagram Business/Creator
IG_BUSINESS_ACCOUNT_ID=

# Token de acceso de la Página de Facebook vinculada (larga duración)
FB_PAGE_ACCESS_TOKEN=

# Versión de la Graph API a usar
GRAPH_API_VERSION=v22.0

# Base URL pública donde se alojan los vídeos generados para que
# Meta pueda descargarlos al publicar (ver README, sección de setup)
PUBLIC_VIDEO_HOST_URL=
